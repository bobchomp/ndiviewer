<Window x:Class="NdiViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NDI Viewer" Height="480" Width="640"
        MinHeight="320" MinWidth="420"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="NDI Sources on this network" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Scanning..." Margin="12,0,0,0" Foreground="Gray" VerticalAlignment="Center"/>
        </StackPanel>

        <ListBox x:Name="SourcesListBox" Grid.Row="1"
                 MouseDoubleClick="SourcesListBox_MouseDoubleClick"
                 SelectionChanged="SourcesListBox_SelectionChanged"
                 DisplayMemberPath="Name"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="OpenButton" Content="Open Preview" Padding="12,4" Click="OpenButton_Click" IsEnabled="False"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Margin="0,10,0,0" FontSize="11" Foreground="Gray" TextWrapping="Wrap">
            Double-click a source, or select it and click Open Preview. This product uses NDI®, a
            registered trademark of Vizrt NDI AB. <Hyperlink NavigateUri="https://ndi.video" RequestNavigate="Hyperlink_RequestNavigate">ndi.video</Hyperlink>
        </TextBlock>
    </Grid>
</Window>
