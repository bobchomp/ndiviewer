<Window x:Class="NdiViewer.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NDI Preview" Height="540" Width="960" MinHeight="200" MinWidth="320"
        Icon="/Assets/app.ico"
        Background="Black">
    <Grid>
        <Image x:Name="VideoImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
        <TextBlock x:Name="OverlayText" Text="Connecting..." Foreground="White" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <TextBlock x:Name="InfoText" Foreground="#CCFFFFFF" FontSize="11" Margin="8"
                   HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
    </Grid>
</Window>
